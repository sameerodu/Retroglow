<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep metallic outer rim -->
    <item>
        <shape android:shape="rectangle">

            <corners android:radius="36dp" />

            <gradient
                android:angle="270"
                android:startColor="#171513"
                android:centerColor="#4A4034"
                android:endColor="#151311" />

            <stroke
                android:width="1dp"
                android:color="#0D0C0B" />

        </shape>
    </item>

    <!-- Main champagne-metal body -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <corners android:radius="34dp" />

            <gradient
                android:angle="270"
                android:startColor="#B9A78B"
                android:centerColor="#E2D0B0"
                android:endColor="#89775F" />

            <stroke
                android:width="1dp"
                android:color="#F4E6C9" />

        </shape>

    </item>

    <!-- Subtle dark lower edge -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">

        <shape android:shape="rectangle">

            <corners android:radius="33dp" />

            <gradient
                android:angle="270"
                android:startColor="#00FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#33000000" />

        </shape>

    </item>

</layer-list>
