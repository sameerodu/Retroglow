<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark outer metal rim -->
    <item>
        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:gradientRadius="24dp"
                android:centerX="35%"
                android:centerY="28%"
                android:startColor="#D9C8A9"
                android:centerColor="#766653"
                android:endColor="#25211D" />

            <stroke
                android:width="2dp"
                android:color="#171411" />

        </shape>
    </item>

    <!-- Raised inner face -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:gradientRadius="19dp"
                android:centerX="32%"
                android:centerY="25%"
                android:startColor="#F1E1C2"
                android:centerColor="#B29B79"
                android:endColor="#5C4D3B" />

            <stroke
                android:width="1dp"
                android:color="#E4D2AF" />

        </shape>

    </item>

    <!-- Central dark indicator -->
    <item
        android:left="17dp"
        android:top="17dp"
        android:right="17dp"
        android:bottom="17dp">

        <shape android:shape="oval">

            <solid android:color="#30271F" />

            <stroke
                android:width="1dp"
                android:color="#0F0D0B" />

        </shape>

    </item>

    <!-- Small amber indicator mark -->
    <item
        android:left="21dp"
        android:top="8dp"
        android:right="21dp"
        android:bottom="25dp">

        <shape android:shape="rectangle">

            <corners android:radius="2dp" />

            <gradient
                android:angle="270"
                android:startColor="#FFE29A"
                android:endColor="#D8750A" />

        </shape>

    </item>

</layer-list>
