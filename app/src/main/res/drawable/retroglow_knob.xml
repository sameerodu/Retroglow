<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deep contact shadow -->
    <item
        android:left="1dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="0dp">

        <shape android:shape="oval">

            <solid android:color="#17130F" />

        </shape>

    </item>

    <!-- Dark outer metal rim -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="3dp">

        <shape android:shape="oval">

            <gradient
                android:angle="315"
                android:startColor="#514A42"
                android:centerColor="#D8CCBB"
                android:endColor="#74695C" />

            <stroke
                android:width="1dp"
                android:color="#EFE4D3" />

        </shape>

    </item>

    <!-- Inner metal surface -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="7dp">

        <shape android:shape="oval">

            <gradient
                android:angle="315"
                android:startColor="#F4EBDD"
                android:centerColor="#BEB2A2"
                android:endColor="#73695D" />

        </shape>

    </item>

    <!-- Small upper highlight -->
    <item
        android:left="10dp"
        android:top="8dp"
        android:right="25dp"
        android:bottom="23dp">

        <shape android:shape="oval">

            <solid android:color="#FFF9EE" />

        </shape>

    </item>

</layer-list>
