<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Warm amber outer glow -->
    <item>
        <shape android:shape="rectangle">

            <corners android:radius="17dp" />

            <gradient
                android:angle="0"
                android:startColor="#B85A08"
                android:centerColor="#F39A18"
                android:endColor="#FFC857" />

        </shape>
    </item>

    <!-- Bright inner illumination -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <corners android:radius="15dp" />

            <gradient
                android:angle="0"
                android:startColor="#D86A08"
                android:centerColor="#FFB52E"
                android:endColor="#FFE08A" />

        </shape>

    </item>

    <!-- Subtle illuminated core -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">

        <shape android:shape="rectangle">

            <corners android:radius="13dp" />

            <gradient
                android:angle="0"
                android:startColor="#E87909"
                android:centerColor="#FFBE3B"
                android:endColor="#FFE7A3" />

        </shape>

    </item>

</layer-list>
